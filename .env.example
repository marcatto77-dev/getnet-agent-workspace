# Copie para .env. Nunca publique a chave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# No primeiro `docker compose up --build`, coleta e indexa o corpus se ele estiver vazio.
RAG_AUTO_INGEST=true
DEFAULT_CUSTOMER_PASSWORD=123
CHAT_ALLOW_ANONYMOUS_DEMO=true
# challenge permite apenas clima/câmbio fora do domínio Getnet; strict recusa ambos.
# Política atual: Getnet + cotação de câmbio; valores legados não liberam clima.
OFF_TOPIC_POLICY=getnet_exchange
WEB_SEARCH_ALLOWED_DOMAINS=getnet.net,site.getnet.com.br
RAG_MAX_DISTANCE=0.8
GUARDRAIL_TOOL_TIMEOUT_SECONDS=8
DATABASE_URL=postgresql://getnet:getnet_local@localhost:5433/getnet
POSTGRES_PASSWORD=getnet_local
# Limites locais por dia UTC; não substituem os controles de cobrança do provedor.
DAILY_MODEL_CALL_LIMIT=100
DAILY_WEB_CALL_LIMIT=10
MAX_OUTPUT_TOKENS=900
DEMO_MODE=true
# Troque o segredo e as credenciais fora do ambiente local de demonstração.
AUTH_JWT_SECRET=change-this-demo-secret-before-production
AUTH_COOKIE_NAME=getnet_session
CUSTOMER_COOKIE_NAME=getnet_customer_session
AUTH_SESSION_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=900
RATE_LIMIT_BACKEND=database
HANDOFF_OFFLINE_TIMEOUT_SECONDS=300
HANDOFF_MODE=manual
MAX_CHATS_PER_TECH=5
SLA_WAIT_WARN_SECONDS=120
ALLOW_PULL=true
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
MAX_REQUEST_BODY_BYTES=32768
WEBSOCKET_MAX_MESSAGE_BYTES=8192
WEBSOCKET_MESSAGES_PER_MINUTE=60
WEBSOCKET_IDLE_TIMEOUT_SECONDS=120
CHAT_REQUESTS_PER_MINUTE=20
CUSTOMER_DAILY_TOKEN_BUDGET=100000
MAX_ACTIVE_CONVERSATIONS_PER_CUSTOMER=3
INGEST_ALLOWED_DOMAINS=getnet.net,site.getnet.com.br
INGEST_TIMEOUT_SECONDS=10
INGEST_MAX_BYTES=2000000
INGEST_PDF_MAX_BYTES=10000000
INGEST_PDF_MAX_PAGES=100
INGEST_MAX_REDIRECTS=4
RETENTION_DAYS=365
RETENTION_ACTION=anonymize
RETENTION_INTERVAL_HOURS=24
CONVERSATION_HISTORY_MESSAGES=8
CONVERSATION_HISTORY_CHARS=6000
CONVERSATION_SUMMARY_CHARS=3000
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_CIRCUIT_FAILURE_THRESHOLD=4
OPENAI_CIRCUIT_RESET_SECONDS=60
# Defina para autenticar /metrics; sem token, a rota só aceita loopback/rede interna.
METRICS_TOKEN=
SEED_ADMIN_USERNAME=Admin
SEED_ADMIN_PASSWORD=Admin
SEED_ADMIN_DISPLAY_NAME=Administrador
SEED_TECHNICIAN_USERNAME=Tecnico
SEED_TECHNICIAN_PASSWORD=Tecnico
SEED_TECHNICIAN_DISPLAY_NAME=Técnico
